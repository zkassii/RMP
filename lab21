        Button(
            onClick = { showDialog = true },
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Авторизоваться")
        }
    }

    if (showDialog) {
        AlertDialog(
            onDismissRequest = { showDialog = false },
            title = { Text("Авторизация") },
            text = { Text("Добро пожаловать, $login") },
            confirmButton = {
                TextButton(onClick = { showDialog = false }) {
                    Text("ОК")
                }
            }
        )
    }
}

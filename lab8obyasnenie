### 5.5 Делегирование интерфейсов

```kotlin
// 5.5.1 Интерфейс сервиса доставки
interface DeliveryService {
    val serviceName: String
    fun deliver(orderNumber: String)
}

// 5.5.2 Реализация
class FoodService : DeliveryService {
    override val serviceName: String = "ВкусДоставка"

    override fun deliver(orderNumber: String) {
        println("Заказ $orderNumber передан в доставку через $serviceName")
    }
}

// 5.5.3 Класс Приложения с делегированием
class DeliveryApp(private val deliveryService: DeliveryService) : DeliveryService by deliveryService {

    // Собственный метод
    fun createOrder(orderNumber: String) {
        println("Приложение: Создаём заказ $orderNumber")
        deliver(orderNumber)   // вызываем метод через делегирование
    }
}
```


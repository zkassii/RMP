### 5.2 Переопределение методов и свойств

```kotlin
class Person(val name: String, val age: Int) {

    // Свойство на чтение (read-only) — вся информация о человеке
    open val fullInfo: String
        get() = "Человек: $name, возраст: $age лет"

    // Метод вывода информации
    open fun printInfo() {
        println("=== Информация о Person ===")
        println("Имя: $name")
        println("Возраст: $age")
    }

    override fun toString(): String {
        return "Person: $name, $age лет"
    }
}

class Student(name: String, age: Int, val group: String) : Person(name, age) {

    // Переопределение свойства
    override val fullInfo: String
        get() = "Студент: $name, возраст: $age, группа: $group"

    // Переопределение метода (вызываем родительский!)
    override fun printInfo() {
        super.printInfo()                    // вызов родительской версии
        println("Группа: $group")            // добавляем свою строку
        println("=== Конец информации о студенте ===")
    }

    override fun toString(): String {
        return "${super.toString()} (Студент группы $group)"
    }
}
```


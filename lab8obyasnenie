### 5.1 Родительский и дочерний классы

```kotlin
// 5.1.1 Родительский класс
class Person(val name: String, val age: Int) {

    // Конструктор уже в primary constructor
    init {
        println("Создан Person: $name, возраст $age")
    }

    // Будем переопределять ниже
    override fun toString(): String {
        return "Person(name='$name', age=$age)"
    }
}

// 5.1.2 Дочерний класс
class Student(name: String, age: Int, val group: String) : Person(name, age) {

    init {
        println("Создан Student группы $group")
    }

    override fun toString(): String {
        // Используем реализацию родителя + добавляем своё
        return "${super.toString()} + Student(group='$group')"
    }
}
```


### 5.4 Обобщённый интерфейс и его реализации

```kotlin
// 5.4.1 Интерфейс
interface DataSource<T> {
    fun getNext(): T?   // возвращает следующий элемент или null, если закончились
}

// 5.4.2 RandomDataSource
class RandomDataSource : DataSource<Int> {
    private var count = 0

    override fun getNext(): Int? {
        return if (count < 20) {           // ограничим, чтобы не было бесконечно
            count++
            (1..100).random()
        } else null
    }
}

// 5.4.3 StaticDataSource
class StaticDataSource<T>(private val data: Array<T>) : DataSource<T> {
    private var index = 0

    override fun getNext(): T? {
        return if (index < data.size) {
            data[index++]
        } else null
    }
}

// 5.4.4 Тестовая функция
fun print10Elements(source: DataSource<*>) {
    println("=== Выводим 10 элементов ===")
    for (i in 1..10) {
        val item = source.getNext()
        if (item != null) {
            println("Элемент $i: $item")
        } else {
            println("Элементы закончились на $i")
            break
        }
    }
    println()
}
```


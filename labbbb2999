```kotlin
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun PostListScreen(
    vm: PostViewModel,
    onAddPost: () -> Unit,
    onAddComment: (Int) -> Unit
) {
    val posts by vm.posts.collectAsState()
    val comments by vm.comments.collectAsState()
    val expandedPostId by vm.expandedPostId.collectAsState()
    val isLoading by vm.isLoading.collectAsState()
    val errorMessage by vm.errorMessage.collectAsState()

    Scaffold(
        topBar = {
            TopAppBar(title = { Text("Посты") })
        },
        floatingActionButton = {
            FloatingActionButton(onClick = onAddPost) {
                Icon(Icons.Default.Add, contentDescription = "Добавить пост")
            }
        }
    ) { padding ->

        // Показ ошибки
        errorMessage?.let { error ->
            AlertDialog(
                onDismissRequest = { vm.clearError() },
                title = { Text("Ошибка") },
                text = { Text(error) },
                confirmButton = {
                    TextButton(onClick = { vm.clearError() }) { Text("OK") }
                }
            )
        }

        if (isLoading) {
            Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                CircularProgressIndicator()
            }
        } else if (posts.isEmpty()) {
            Box(Modifier.fillMaxSize().padding(padding), contentAlignment = Alignment.Center) {
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Text("Посты не загружены")
                    Spacer(modifier = Modifier.height(8.dp))
                    Button(onClick = { vm.loadPosts() }) { Text("Повторить") }
                }
            }
        } else {
            LazyColumn(
                contentPadding = padding,
                modifier = Modifier.fillMaxSize()
            ) {
                items(posts) { post ->
                    PostCard(
                        post = post,
                        isExpanded = expandedPostId == post.id,
                        comments = comments[post.id] ?: emptyList(),
                        onToggleComments = { vm.toggleComments(post.id) },
                        onAddComment = { onAddComment(post.id) }
                    )
                }
            }
        }
    }
}

```kotlin
package com.example.lab29

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.launch

class PostViewModel : ViewModel() {

    private val _posts = MutableStateFlow<List<Post>>(emptyList())
    val posts: StateFlow<List<Post>> = _posts

    private val _comments = MutableStateFlow<Map<Int, List<Comment>>>(emptyMap())
    val comments: StateFlow<Map<Int, List<Comment>>> = _comments

    private val _expandedPostId = MutableStateFlow<Int?>(null)
    val expandedPostId: StateFlow<Int?> = _expandedPostId

    private val _isLoading = MutableStateFlow(false)
    val isLoading: StateFlow<Boolean> = _isLoading

    private val _errorMessage = MutableStateFlow<String?>(null)
    val errorMessage: StateFlow<String?> = _errorMessage

    init {
        loadPosts()
    }

    fun loadPosts() {
        viewModelScope.launch {
            _isLoading.value = true
            _errorMessage.value = null
            try {
                val result = Api.service.getPosts()
                _posts.value = result
            } catch (e: Exception) {
                _errorMessage.value = "Ошибка: ${e.javaClass.simpleName}: ${e.message}"
                e.printStackTrace()
            } finally {
                _isLoading.value = false
            }
        }
    }

    fun toggleComments(postId: Int) {
        if (_expandedPostId.value == postId) {
            _expandedPostId.value = null
        } else {
            _expandedPostId.value = postId
            if (_comments.value[postId] == null) {
                loadComments(postId)
            }
        }
    }

    private fun loadComments(postId: Int) {
        viewModelScope.launch {
            try {
                val result = Api.service.getComments(postId)
                _comments.value = _comments.value.toMutableMap().also {
                    it[postId] = result
                }
            } catch (e: Exception) {
                _errorMessage.value = "Ошибка комментариев: ${e.javaClass.simpleName}: ${e.message}"
                e.printStackTrace()
            }
        }
    }

    fun createPost(title: String, body: String, onSuccess: () -> Unit) {
        viewModelScope.launch {
            try {
                val newPost = Api.service.createPost(NewPost(title, body))
                _posts.value = listOf(newPost) + _posts.value
                onSuccess()
            } catch (e: Exception) {
                _errorMessage.value = "Ошибка создания поста: ${e.message}"
                e.printStackTrace()
            }
        }
    }

    fun createComment(body: String, postId: Int, onSuccess: () -> Unit) {
        viewModelScope.launch {
            try {
                val newComment = Api.service.createComment(NewComment(body, postId))
                val current = _comments.value[postId]?.toMutableList() ?: mutableListOf()
                current.add(newComment)
                _comments.value = _comments.value.toMutableMap().also {
                    it[postId] = current
                }
                onSuccess()
            } catch (e: Exception) {
                _errorMessage.value = "Ошибка создания комментария: ${e.message}"
                e.printStackTrace()
            }
        }
    }

    fun clearError() {
        _errorMessage.value = null
    }
}

                }
            },
            enabled = agreed,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Зарегистрироваться")
        }

        if (message.isNotEmpty()) {
            Text(message, color = if (message.contains("зарегистрированы")) Color.Green else Color.Red)
        }
    }

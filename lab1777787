@Composable
fun AboutMeScreen() {
    var text by remember { mutableStateOf("") }
    val maxLength = 300

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp)
    ) {
        Text("Расскажите о себе", style = MaterialTheme.typography.headlineMedium)
        Spacer(modifier = Modifier.height(8.dp))

        OutlinedTextField(
            value = text,
            onValueChange = {
                if (it.length <= maxLength) text = it
            },
            label = { Text("О себе") },
            placeholder = { Text("Напишите здесь...") },
            modifier = Modifier
                .fillMaxWidth()
                .height(200.dp),
            maxLines = 10
        )

        Text(
            text = "Осталось символов: ${maxLength - text.length}",
            modifier = Modifier.padding(top = 8.dp)
        )
    }
}

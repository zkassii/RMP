### 2. NavigationRoutes.kt — маршруты навигации

```kotlin
package com.example.yourapp.screens   // Замени на свой пакет

// Sealed class используется, когда некоторые экраны имеют параметры (например, название товара)
sealed class Screen(val route: String) {

    // Экран авторизации — простой маршрут без параметров
    data object Auth : Screen("auth")

    // Экран регистрации — простой маршрут
    data object Register : Screen("register")

    // Экран списка товаров — простой маршрут
    data object ProductList : Screen("product_list")

    // Экран детальной информации о товаре — имеет параметр {name}
    data class ProductDetail(val productName: String) : Screen("product_detail/{name}") {

        // Функция для создания правильного маршрута с параметром
        // Например: "product_detail/Смартфон"
        fun createRoute(name: String): String = "product_detail/$name"
    }
}

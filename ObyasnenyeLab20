### 7. MainActivity.kt — главная навигация

```kotlin
package com.example.yourapp

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.runtime.Composable
import androidx.navigation.NavType
import androidx.navigation.compose.NavHost
import androidx.navigation.compose.composable
import androidx.navigation.compose.rememberNavController
import androidx.navigation.navArgument
import com.example.yourapp.screens.*

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            YourAppTheme {           // замени на имя своей темы
                AppNavigation()
            }
        }
    }
}

@Composable
fun AppNavigation() {
    // Создаём контроллер навигации
    val navController = rememberNavController()

    // NavHost — главный контейнер, который показывает нужный экран
    NavHost(
        navController = navController,
        startDestination = Screen.Auth.route   // стартовый экран — авторизация
    ) {
        // === Экран авторизации ===
        composable(Screen.Auth.route) {
            AuthScreen(
                onLoginClick = { navController.navigate(Screen.ProductList.route) },
                onRegisterClick = { navController.navigate(Screen.Register.route) },
                onBack = { navController.popBackStack() }
            )
        }

        // === Экран регистрации ===
        composable(Screen.Register.route) {
            RegisterScreen(
                onRegisterSuccess = { navController.navigate(Screen.Auth.route) },
                onBack = { navController.popBackStack() }
            )
        }

        // === Список товаров ===
        composable(Screen.ProductList.route) {
            ProductListScreen(
                onProductClick = { name ->
                    // Переход с передачей параметра
                    navController.navigate(Screen.ProductDetail(name).createRoute(name))
                },
                onBack = { navController.popBackStack() }
            )
        }

        // === Детальная страница товара с параметром ===
        composable(
            route = "product_detail/{name}",
            arguments = listOf(navArgument("name") { type = NavType.StringType })
        ) { backStackEntry ->
            // Получаем параметр из маршрута
            val name = backStackEntry.arguments?.getString("name") ?: "Неизвестный товар"
            ProductDetailScreen(
                productName = name,
                onBack = { navController.popBackStack() }
            )
        }
    }
}





### 8 Контрольные вопросы

**8.1 Какую зависимость нужно добавить в Gradle для поддержки навигации?**  
`implementation("androidx.navigation:navigation-compose:2.9.7")`

**8.2 Для чего предназначен NavHost?**  
NavHost — контейнер, который отображает нужный экран в зависимости от текущего маршрута.

**8.3 Для чего предназначен NavController?**  
NavController управляет навигацией: переходами между экранами и возвратом назад.

**8.4 Что указывается в графе навигации?**  
Маршруты экранов и их связь с composable-функциями.

**8.5 В каких случаях для организации маршрутов используется sealed class?**  
Когда маршруты имеют параметры (например, название товара).

**8.6 В каких случаях для организации маршрутов используется enum?**  
Когда все маршруты простые и не содержат параметров.

**8.7 Как считать параметры, переданные при навигации?**  
Через `backStackEntry.arguments?.getString("name")` (указав тип в `navArgument`).


import androidx.compose.material.icons.filled.ArrowBack

// onProductClick — вызывается при нажатии на товар, передаёт название товара
@Composable
fun ProductListScreen(
    onProductClick: (String) -> Unit,
    onBack: () -> Unit = {}
) {
    // Список из 10 товаров (по заданию)
    val products = listOf(
        "Смартфон", "Ноутбук", "Наушники", "Планшет", "Часы",
        "Камера", "Клавиатура", "Мышь", "Монитор", "Принтер"
    )

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Список товаров") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "Назад")
                    }
                }
            )
        }
    ) { paddingValues ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
                .padding(16.dp)
        ) {
            items(products) { productName ->
                Card(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(vertical = 8.dp)
                        .clickable { onProductClick(productName) },  // переход на экран товара
                    elevation = CardDefaults.cardElevation(defaultElevation = 4.dp)
                ) {
                    Text(
                        text = productName,
                        modifier = Modifier.padding(16.dp),
                        style = MaterialTheme.typography.titleMedium
                    )
                }
            }
        }
    }
}

@Composable
fun LabScreen() {
    val scrollState = rememberScrollState()
    
    // Данные времени
    val calendar = Calendar.getInstance()
    val hour = calendar.get(Calendar.HOUR_OF_DAY)
    val minute = calendar.get(Calendar.MINUTE)
    val year = calendar.get(Calendar.YEAR)
    
    // Твои ресурсы из файлов
    val authors = stringArrayResource(id = R.array.authors)
    val hoursText = pluralStringResource(id = R.plurals.hours, count = hour, hour)
    val minutesText = pluralStringResource(id = R.plurals.minutes, count = minute, minute)

    // Внешний Column на весь экран
    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(colorResource(id = R.color.background))
    ) {
        
        // --- Верхняя панель (Фиксированная) ---
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(all = dimensionResource(id = R.dimen.padding_standard)),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(
                text = stringResource(id = R.string.app_name),
                // Используем твой CustomFontFamily из Type.kt
                style = MaterialTheme.typography.titleLarge.copy(fontFamily = CustomFontFamily),
                color = colorResource(id = R.color.text),
                modifier = Modifier.weight(weight = 1f)
            )
            
            TextField(
                value = "",
                onValueChange = {},
                placeholder = { Text(text = stringResource(id = R.string.search)) },
                modifier = Modifier
                    .weight(weight = 2f)
                    .height(dimensionResource(id = R.dimen.search_height))
                    .padding(horizontal = 8.dp),
                colors = TextFieldDefaults.colors(
                    unfocusedContainerColor = colorResource(id = R.color.search_bg)
                )
            )

            IconButton(
                onClick = {},
                modifier = Modifier.size(size = dimensionResource(id = R.dimen.menu_button_size))
            ) {
                Icon(
                    painter = painterResource(id = R.drawable.cat1), // Твой вектор cat1.xml
                    contentDescription = stringResource(id = R.string.menu),
                    tint = colorResource(id = R.color.primary),
                    modifier = Modifier.size(size = dimensionResource(id = R.dimen.vector_icon_size))
                )
            }
        }

        // --- Скроллируемая область ---
        Column(
            modifier = Modifier
                .weight(weight = 1f) // Это "толкает" контент и включает скролл
                .verticalScroll(state = scrollState)
                .padding(all = dimensionResource(id = R.dimen.padding_standard)),
            verticalArrangement = Arrangement.spacedBy(space = 24.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            // Текущее время
            Text(
                text = "$hour $hoursText $minute $minutesText",
                style = MaterialTheme.typography.headlineMedium.copy(fontFamily = CustomFontFamily),
                color = colorResource(id = R.color.primary)
            )

            // Векторная иконка
            Text(
                text = "Векторная иконка (XML)", 
                fontFamily = CustomFontFamily,
                color = colorResource(id = R.color.text)
            )
            Image(
                painter = painterResource(id = R.drawable.cat1),
                contentDescription = null,
                modifier = Modifier
                    .size(size = dimensionResource(id = R.dimen.image_size))
                    .background(colorResource(id = R.color.accent)),
                colorFilter = ColorFilter.tint(colorResource(id = R.color.primary))
            )

            // Растровое изображение (Твой cat.jpg)
            Text(
                text = "Растровое изображение (PNG) — круглое", 
                fontFamily = CustomFontFamily,
                color = colorResource(id = R.color.text)
            )
            Image(
                painter = painterResource(id = R.drawable.cat), // Твой cat.jpg из drawable
                contentDescription = null,
                contentScale = ContentScale.Crop, // Чтобы круг не сплющило
                modifier = Modifier
                    .size(size = dimensionResource(id = R.dimen.image_size))
                    .clip(shape = CircleShape) // Идеальный круг
            )

            // Список авторов (Копирайт)
            authors.forEach { author ->
                Text(
                    text = stringResource(id = R.string.copyright, author, year),
                    style = MaterialTheme.typography.bodyMedium.copy(fontFamily = CustomFontFamily),
                    color = colorResource(id = R.color.text)
                )
            }
            
            Text(
                text = "Все элементы используют ресурсы",
                fontFamily = CustomFontFamily,
                color = colorResource(id = R.color.text)
            )
        }
    }
}

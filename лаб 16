@Composable
fun LabScreen() {
    val scrollState = rememberScrollState()
    
    // Получаем данные времени (как у тебя в коде)
    val calendar = Calendar.getInstance()
    val hour = calendar.get(Calendar.HOUR_OF_DAY)
    val minute = calendar.get(Calendar.MINUTE)
    val year = calendar.get(Calendar.YEAR)
    
    val developers = stringArrayResource(id = R.array.authors)
    val hoursText = pluralStringResource(id = R.plurals.hours, count = hour, hour)
    val minutesText = pluralStringResource(id = R.plurals.minutes, count = minute, minute)

    // ВНЕШНИЙ КОНТЕЙНЕР
    Column(modifier = Modifier.fillMaxSize()) {
        
        // 1. ФИКСИРОВАННАЯ ВЕРХНЯЯ ПАНЕЛЬ (теперь она не будет улетать в небо)
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(
                text = stringResource(id = R.string.app_name),
                style = MaterialTheme.typography.titleLarge.copy(fontFamily = CustomFontFamily),
                modifier = Modifier.weight(1f)
            )
            
            TextField(
                value = "",
                onValueChange = {},
                placeholder = { Text(text = stringResource(id = R.string.search)) },
                modifier = Modifier
                    .weight(2f)
                    .height(dimensionResource(id = R.dimen.search_height))
                    .padding(horizontal = 8.dp),
                colors = TextFieldDefaults.colors(
                    unfocusedContainerColor = colorResource(id = R.color.search_bg)
                )
            )

            IconButton(
                onClick = {},
                modifier = Modifier.size(dimensionResource(id = R.dimen.menu_button_size))
            ) {
                Icon(
                    painter = painterResource(id = R.drawable.cat1),
                    contentDescription = null,
                    tint = colorResource(id = R.color.primary),
                    modifier = Modifier.size(dimensionResource(id = R.dimen.vector_icon_size))
                )
            }
        }

        // 2. СКРОЛЛИРУЕМАЯ ЧАСТЬ (занимает всё оставшееся место)
        Column(
            modifier = Modifier
                .weight(1f) // Это заставляет скролл работать правильно
                .verticalScroll(scrollState)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(24.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            // Время
            Text(
                text = "$hour $hoursText $minute $minutesText",
                style = MaterialTheme.typography.headlineMedium.copy(fontFamily = CustomFontFamily),
                color = colorResource(id = R.color.primary)
            )

            Spacer(modifier = Modifier.height(8.dp))

            // Векторная иконка
            Text(text = "Векторная иконка (XML)", fontFamily = CustomFontFamily)
            Image(
                painter = painterResource(id = R.drawable.cat1),
                contentDescription = null,
                modifier = Modifier
                    .size(dimensionResource(id = R.dimen.image_size))
                    .background(colorResource(id = R.color.accent)),
                colorFilter = ColorFilter.tint(colorResource(id = R.color.primary))
            )

            // Растровое изображение (КРУГЛОЕ)
            Text(text = "Растровое изображение (PNG) — круглое", fontFamily = CustomFontFamily)
            Image(
                painter = painterResource(id = R.drawable.cat),
                contentDescription = null,
                contentScale = ContentScale.Crop, // ВАЖНО для правильной обрезки
                modifier = Modifier
                    .size(dimensionResource(id = R.dimen.image_size))
                    .clip(CircleShape) // Обрезаем по кругу
            )

            // Копирайты внизу списка
            developers.forEach { dev ->
                Text(
                    text = stringResource(id = R.string.copyright, dev, year),
                    style = MaterialTheme.typography.bodyMedium.copy(fontFamily = CustomFontFamily),
                    color = colorResource(id = R.color.text)
                )
            }
            
            Text(
                text = "Все элементы используют ресурсы",
                fontFamily = CustomFontFamily,
                color = colorResource(id = R.color.text)
            )
        }
    }
}

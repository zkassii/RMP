## 📄 Screen5Tasks.kt — Задание 5.5 (ExtendedFloatingActionButton)

```kotlin
package com.example.ТВОЙПРОЕКТ

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.itemsIndexed
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.Add
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

@Composable
fun Screen5Tasks() {
    var tasks by remember {
        mutableStateOf(
            listOf(
                "Купить продукты",
                "Сделать зарядку",
                "Позвонить маме",
                "Прочитать книгу",
                "Убраться дома"
            )
        )
    }
    val checked = remember { mutableStateListOf(*Array(100) { false }) }
    var taskCount by remember { mutableStateOf(tasks.size) }

    Box(modifier = Modifier.fillMaxSize()) {
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 16.dp)
        ) {
            itemsIndexed(tasks) { index, task ->
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(vertical = 4.dp)
                ) {
                    Checkbox(
                        checked = if (index < checked.size) checked[index] else false,
                        onCheckedChange = { checked[index] = it }
                    )
                    Text(text = task, fontSize = 16.sp)
                }
            }
            // Отступ снизу чтобы кнопка не перекрывала последний элемент
            item { Spacer(modifier = Modifier.height(80.dp)) }
        }

        // ExtendedFloatingActionButton снизу справа
        ExtendedFloatingActionButton(
            onClick = {
                taskCount++
                tasks = tasks + "Новая задача $taskCount"
            },
            icon = { Icon(Icons.Filled.Add, contentDescription = "Добавить") },
            text = { Text("Добавить") },
            modifier = Modifier
                .align(Alignment.BottomEnd)
                .padding(16.dp)
        )
    }
}

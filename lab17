### 3. `PinCodeScreen.kt`

```kotlin
package com.example.lab17

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.text.input.KeyboardType

@Composable
fun PinCodeScreen() {
    var pin by remember { mutableStateOf("") }
    var attempts by remember { mutableStateOf(3) }
    var message by remember { mutableStateOf("") }
    val correctPin = "1234" // можешь изменить

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(16.dp)
    ) {
        Text("Ввод ПИН-кода", style = MaterialTheme.typography.headlineMedium)

        OutlinedTextField(
            value = pin,
            onValueChange = {
                if (it.length <= 4 && it.all { char -> char.isDigit() }) {
                    pin = it
                }
            },
            label = { Text("ПИН-код") },
            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
            modifier = Modifier.fillMaxWidth()
        )

        Button(
            onClick = {
                if (pin.length == 4) {
                    if (pin == correctPin) {
                        message = "Код верный!"
                        attempts = 3
                    } else {
                        attempts--
                        message = if (attempts > 0) "Неверный код. Осталось попыток: $attempts" else "Попытки исчерпаны"
                    }
                    pin = ""
                }
            },
            enabled = attempts > 0 && pin.length == 4,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Отправить")
        }

        Text("Попыток осталось: $attempts", color = if (attempts > 0) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.error)
        if (message.isNotEmpty()) Text(message)
    }
}

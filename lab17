### 5. `FontSettingsScreen.kt`

```kotlin
package com.example.lab17

import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.selection.selectable
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.compose.ui.text.font.*

@Composable
fun FontSettingsScreen() {
    var fontSize by remember { mutableStateOf(16f) }
    var isBold by remember { mutableStateOf(false) }
    var isItalic by remember { mutableStateOf(false) }
    var selectedColor by remember { mutableStateOf(Color.Black) }

    val colors = listOf(
        Color.Black to "Чёрный",
        Color.Red to "Красный",
        Color.Blue to "Синий",
        Color.Green to "Зелёный",
        Color.Magenta to "Пурпурный"
    )

    Column(modifier = Modifier.padding(16.dp)) {
        Text(
            text = "Пример текста",
            fontSize = fontSize.sp,
            fontWeight = if (isBold) FontWeight.Bold else FontWeight.Normal,
            fontStyle = if (isItalic) FontStyle.Italic else FontStyle.Normal,
            color = selectedColor,
            modifier = Modifier.padding(bottom = 16.dp)
        )

        // Радиокнопки цветов
        colors.forEach { (color, name) ->
            Row(
                verticalAlignment = Alignment.CenterVertically,
                modifier = Modifier
                    .fillMaxWidth()
                    .selectable(selected = selectedColor == color, onClick = { selectedColor = color })
                    .padding(vertical = 4.dp)
            ) {
                RadioButton(
                    selected = selectedColor == color,
                    onClick = { selectedColor = color }
                )
                Box(
                    modifier = Modifier
                        .size(24.dp)
                        .background(color)
                        .padding(horizontal = 8.dp)
                )
                Text(name)
            }
        }

        Slider(
            value = fontSize,
            onValueChange = { fontSize = it },
            valueRange = 10f..30f,
            steps = 19,
            modifier = Modifier.fillMaxWidth()
        )
        Text("Размер: ${fontSize.toInt()}")

        Row(verticalAlignment = Alignment.CenterVertically) {
            Switch(checked = isBold, onCheckedChange = { isBold = it })
            Text("Полужирный")
        }
        Row(verticalAlignment = Alignment.CenterVertically) {
            Switch(checked = isItalic, onCheckedChange = { isItalic = it })
            Text("Курсив")
        }
    }
}

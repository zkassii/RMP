### 4. `AboutMeScreen.kt`

```kotlin
package com.example.lab17

import androidx.compose.foundation.layout.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier

@Composable
fun AboutMeScreen() {
    var text by remember { mutableStateOf("") }
    val maxLength = 300

    Column(modifier = Modifier.padding(16.dp)) {
        Text("О себе", style = MaterialTheme.typography.headlineMedium)

        // Отображение оставшихся символов
        Text("Осталось символов: ${maxLength - text.length}")

        OutlinedTextField(
            value = text,
            onValueChange = {
                // Ограничение длины текста
                if (it.length <= maxLength) {
                    text = it
                }
            },
            label = { Text("Расскажите о себе") },
            modifier = Modifier
                .fillMaxWidth()
                .height(200.dp),           // высота под большой текст
            maxLines = 10
        )
    }
}

package com.example.app.navigation

sealed class AppRoutes(val route: String) {
    object Auth : AppRoutes("auth")
    object Register : AppRoutes("register")
    object ProductList : AppRoutes("product_list")
    object Product : AppRoutes("product/{name}/{price}") {
        fun createRoute(name: String, price: String) = "product/$name/$price"
    }
}
